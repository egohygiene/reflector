        {
            "path": "figures/figure9.png",
            "usage": "include"
        },
        {
            "path": "figures/figure10.png",
            "usage": "include"
        },
        {
            "path": "figures/figure11.png",
            "usage": "include"
        },
        {
            "path": "figures/figure12.png",
            "usage": "include"
        },
        {
            "path": "figures/figure13.png",
            "usage": "include"
        },
        {
            "path": "figures/figure14.png",
            "usage": "include"
        },
        {
            "path": "figures/figure15.png",
            "usage": "include"
        },
        {
            "path": "figures/figure16.png",
            "usage": "include"
        },
        {
            "path": "figures/figure17.png",
            "usage": "include"
        }
    ],

    "build": {
        "output_dir": ".",
        "aux_dir": ".",
        "texinputs": [],
        "orchestration": "direct pdflatex/biber submission path with no hidden runtime files",
        "script": "pdflatex paper.tex && biber paper && pdflatex paper.tex && pdflatex paper.tex",
        "staging": {
            "script": "../scripts/stage_arxiv_submission.py",
            "mode": "declared-TeX-dependency-closure",
            "maximum_submission_bytes": 45000000,
            "excluded_canonical_directories": [
                "assets",
                "references",
                "examples",
                "diagrams"
            ]
        }
    },

    "architecture": {
        "philosophy": "semantic content → publication manifest → renderer target → generated artifact",
        "renderer_target": "arxiv",
        "renderer_abstraction": "Swap paper/styles/reflector.sty to retarget a different publisher without modifying semantic source.",
        "future_portability": true
    }
}
