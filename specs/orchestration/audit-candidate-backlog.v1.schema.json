{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/reflector/contracts/audit-candidate-backlog/v1/schema.json",
  "title": "Public audit candidate backlog source projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "visibility",
    "mutation_authority",
    "synthesis",
    "findings_count",
    "proposals",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.reflector.audit-candidate-backlog/v1"
    },
    "contract_version": {
      "const": "1.0.0-alpha.1"
    },
    "visibility": {
      "const": "public"
    },
    "mutation_authority": {
      "const": "none"
    },
    "synthesis": {
      "const": "deterministic-source-projection"
    },
    "findings_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "proposals": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "repository",
        "report_sha256",
        "finding_id",
        "source_revision",
        "source_path",
        "title",
        "classification",
        "nature",
        "severity",
        "confidence",
        "status",
        "evidence_classification",
        "source_profile",
        "missing_evidence",
        "recommendation",
        "suggested_validation",
        "represented_commit"
      ],
      "properties": {
        "visibility": {
          "const": "public"
        },
        "repository": {
          "type": "string",
          "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{0,95}$"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "nature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "confidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "evidence_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "source_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
            }
          }
        },
        "missing_evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "suggested_validation": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "represented_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "grouping",
        "grouping_rationale",
        "source_finding_keys",
        "sources",
        "review",
        "issue_creation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^proposal-[a-f0-9]{24}$"
        },
        "status": {
          "const": "proposed"
        },
        "grouping": {
          "enum": [
            "explicit",
            "single-finding"
          ]
        },
        "grouping_rationale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "source_finding_keys": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "review": {
          "const": "required"
        },
        "issue_creation": {
          "const": "not-authorized"
        }
      }
    }
  }
}
